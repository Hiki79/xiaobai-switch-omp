---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import { t } from "../i18n/ui";
import { docSlugOf } from "../lib/docs";
import { docIcon } from "../lib/icons";
import { localePath, type Locale } from "../lib/site";
import UiIcon from "../components/UiIcon.astro";

interface Props {
  locale: Locale;
  docs: CollectionEntry<"docs">[];
}

const { locale, docs } = Astro.props;
const seo = t(locale, "seo");
const copy = t(locale, "docs");
---

<BaseLayout
  locale={locale}
  title={copy.outlineTitle}
  description={seo.docsDescription}
  slug="docs"
  docs={docs}
>
  <div class="page-wrap grid flex-1 gap-8 py-8 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <DocsSidebar locale={locale} docs={docs} />
      </div>
    </aside>
    <div>
      <nav class="breadcrumbs text-sm">
        <ul>
          <li><a href={localePath(locale, "")}>{copy.breadcrumbHome}</a></li>
          <li>{copy.breadcrumbDocs}</li>
        </ul>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">{copy.outlineTitle}</h1>
      <p class="mt-3 max-w-2xl opacity-80">{copy.outlineLead}</p>
      <ul class="steps steps-vertical mt-8 w-full">
        {
          docs.map((entry, index) => (
            <li class:list={["step", { "step-primary": index < 3 }]}>
              <a href={localePath(locale, `docs/${docSlugOf(entry)}`)} class="text-left">
                <span class="flex items-center gap-2 font-semibold">
                  <UiIcon name={docIcon(docSlugOf(entry))} />
                  {entry.data.title}
                </span>
                <span class="mt-1 block text-sm font-normal opacity-70">{entry.data.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
