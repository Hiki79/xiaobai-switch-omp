---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import {
  APP_NAME,
  GITHUB_LATEST_RELEASE_URL,
  SITE_ORIGIN,
  assetUrl,
  localePath,
  type Locale,
} from "../lib/site";
import UiIcon from "../components/UiIcon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const seo = t(locale, "seo");
const hero = t(locale, "hero");
const steps = t(locale, "steps");
const features = t(locale, "features");
const shots = t(locale, "shots");
const download = t(locale, "download");

const featureItems = [
  { title: features.sites, desc: features.sitesd, href: localePath(locale, "docs/sites"), icon: "lucide:server" },
  { title: features.models, desc: features.modelsd, href: localePath(locale, "docs/models"), icon: "lucide:boxes" },
  { title: features.apply, desc: features.applyd, href: localePath(locale, "docs/apply-claude"), icon: "lucide:bot" },
  { title: features.routes, desc: features.routesd, href: localePath(locale, "docs/routes"), icon: "lucide:git-branch" },
  { title: features.caps, desc: features.capsd, href: localePath(locale, "docs/apply-codex"), icon: "lucide:sparkles" },
  { title: features.backups, desc: features.backupsd, href: localePath(locale, "docs/backups"), icon: "lucide:archive" },
  { title: features.links, desc: features.linksd, href: localePath(locale, "docs/import-link"), icon: "lucide:link" },
  { title: features.keys, desc: features.keysd, href: localePath(locale, "docs/security"), icon: "lucide:lock-keyhole" },
  { title: features.desktop, desc: features.desktopd, href: localePath(locale, "docs/settings"), icon: "lucide:app-window" },
] as const;

const shotItems = [
  { src: "images/screenshots/1.webp", alt: shots.s1 },
  { src: "images/screenshots/2.webp", alt: shots.s2 },
  { src: "images/screenshots/3.webp", alt: shots.s3 },
  { src: "images/screenshots/4.webp", alt: shots.s4 },
] as const;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: APP_NAME,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Windows",
    url: SITE_ORIGIN,
    downloadUrl: GITHUB_LATEST_RELEASE_URL,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    license: "https://opensource.org/licenses/MIT",
    description: seo.homeDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: APP_NAME,
    url: SITE_ORIGIN,
    inLanguage: locale === "zh" ? "zh-CN" : "en",
  },
];
---

<BaseLayout
  locale={locale}
  title={seo.homeTitle}
  description={seo.homeDescription}
  jsonLd={jsonLd}
>
  <section class="bg-base-100">
    <div class="page-wrap flex flex-col items-center gap-10 py-16 lg:flex-row-reverse lg:items-center lg:py-24">
      <img
        src={assetUrl("images/screenshots/3.webp")}
        alt={shots.s3}
        width="960"
        height="600"
        class="w-full max-w-lg rounded-2xl border border-base-300 shadow-xl"
      />
      <div class="w-full max-w-xl">
        <h1 class="text-4xl font-bold leading-tight lg:text-5xl">{hero.title}</h1>
        <p class="py-6 text-lg opacity-80">{hero.subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href={localePath(locale, "download")}>
            <UiIcon name="lucide:download" />
            {hero.ctaDownload}
          </a>
          <a class="btn btn-outline" href={localePath(locale, "docs")}>
            <UiIcon name="lucide:book-open" />
            {hero.ctaDocs}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-wrap py-12">
    <h2 class="mb-2 text-center text-3xl font-bold">{steps.title}</h2>
    <p class="mb-8 text-center opacity-70">{steps.subtitle}</p>
    <ul class="steps steps-vertical lg:steps-horizontal w-full">
      <li class="step step-primary">
        <span class="mt-2 block text-left lg:text-center">
          <strong>{steps.s1}</strong>
          <span class="mt-1 block text-sm font-normal opacity-70">{steps.s1d}</span>
        </span>
      </li>
      <li class="step step-primary">
        <span class="mt-2 block text-left lg:text-center">
          <strong>{steps.s2}</strong>
          <span class="mt-1 block text-sm font-normal opacity-70">{steps.s2d}</span>
        </span>
      </li>
      <li class="step step-primary">
        <span class="mt-2 block text-left lg:text-center">
          <strong>{steps.s3}</strong>
          <span class="mt-1 block text-sm font-normal opacity-70">{steps.s3d}</span>
        </span>
      </li>
      <li class="step step-primary">
        <span class="mt-2 block text-left lg:text-center">
          <strong>{steps.s4}</strong>
          <span class="mt-1 block text-sm font-normal opacity-70">{steps.s4d}</span>
        </span>
      </li>
    </ul>
  </section>

  <section class="bg-base-200">
    <div class="page-wrap py-12">
      <h2 class="mb-8 text-center text-3xl font-bold">{features.title}</h2>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          featureItems.map((item) => (
            <a href={item.href} class="card bg-base-100 border border-base-300 shadow-sm transition hover:border-primary">
              <div class="card-body">
                <h3 class="card-title text-lg">
                  <UiIcon name={item.icon} class="size-5" />
                  {item.title}
                </h3>
                <p class="opacity-80">{item.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-wrap py-12">
    <h2 class="mb-8 text-center text-3xl font-bold">{shots.title}</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {
        shotItems.map((shot) => (
          <figure class="overflow-hidden rounded-2xl border border-base-300 bg-base-200">
            <img src={assetUrl(shot.src)} alt={shot.alt} width="960" height="600" class="h-auto w-full" loading="lazy" />
            <figcaption class="px-4 py-3 text-sm opacity-70">{shot.alt}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="bg-base-200">
    <div class="page-wrap flex flex-col items-start gap-4 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl font-bold">{download.title}</h2>
        <p class="mt-2 opacity-80">{download.subtitle}</p>
      </div>
      <a class="btn btn-primary" href={localePath(locale, "download")}>
        <UiIcon name="lucide:download" />
        {hero.ctaDownload}
      </a>
    </div>
  </section>
</BaseLayout>
