---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import DocsToc from "../components/DocsToc.astro";
import { t } from "../i18n/ui";
import { docSlugOf } from "../lib/docs";
import { localePath, type Locale } from "../lib/site";
import { extractToc } from "../lib/toc";
import UiIcon from "../components/UiIcon.astro";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"docs">;
  docs: CollectionEntry<"docs">[];
}

const { locale, entry, docs } = Astro.props;
const { Content } = await render(entry);
const slug = docSlugOf(entry);
const toc = extractToc(entry.body ?? "");
const copy = t(locale, "docs");
const index = docs.findIndex((item) => item.id === entry.id);
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: locale === "zh" ? "zh-CN" : "en",
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  slug={`docs/${slug}`}
  type="article"
  jsonLd={jsonLd}
  docs={docs}
  currentDocSlug={slug}
>
  <div class="page-wrap grid flex-1 gap-8 py-8 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_14rem]">
    <aside class="hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
        <DocsSidebar locale={locale} docs={docs} currentSlug={slug} />
      </div>
    </aside>
    <article class="min-w-0">
      <nav class="breadcrumbs text-sm">
        <ul>
          <li><a href={localePath(locale, "")}>{copy.breadcrumbHome}</a></li>
          <li><a href={localePath(locale, "docs")}>{copy.breadcrumbDocs}</a></li>
          <li>{entry.data.title}</li>
        </ul>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">{entry.data.title}</h1>
      <p class="mt-3 text-lg opacity-80">{entry.data.description}</p>
      <div class="collapse collapse-arrow bg-base-200 mt-6 xl:hidden">
        <input type="checkbox" />
        <div class="collapse-title font-medium">{copy.onThisPage}</div>
        <div class="collapse-content">
          <DocsToc locale={locale} items={toc} />
        </div>
      </div>
      <div class="prose mt-8 max-w-none">
        <Content />
      </div>
      <div class="mt-12 flex flex-col gap-3 border-t border-base-300 pt-6 sm:flex-row sm:justify-between">
        {
          prev ? (
            <a class="btn btn-ghost justify-start" href={localePath(locale, `docs/${docSlugOf(prev)}`)}>
              <UiIcon name="lucide:arrow-left" />
              {copy.prev}: {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="btn btn-ghost justify-end" href={localePath(locale, `docs/${docSlugOf(next)}`)}>
              {copy.next}: {next.data.title}
              <UiIcon name="lucide:arrow-right" />
            </a>
          ) : (
            <span />
          )
        }
      </div>
    </article>
    <aside class="hidden xl:block">
      <div class="sticky top-20">
        <DocsToc locale={locale} items={toc} />
      </div>
    </aside>
  </div>
</BaseLayout>
