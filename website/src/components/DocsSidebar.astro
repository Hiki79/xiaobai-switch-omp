---
import type { CollectionEntry } from "astro:content";
import { t } from "../i18n/ui";
import { docSlugOf } from "../lib/docs";
import { docIcon } from "../lib/icons";
import { localePath, type Locale } from "../lib/site";
import UiIcon from "./UiIcon.astro";

interface Props {
  locale: Locale;
  docs: CollectionEntry<"docs">[];
  currentSlug?: string;
}

const { locale, docs, currentSlug } = Astro.props;
const heading = t(locale, "docs").contents;
---

<nav aria-label={heading}>
  <p class="mb-2 flex items-center gap-2 px-3 text-xs font-semibold uppercase tracking-wide opacity-60">
    <UiIcon name="lucide:list" />
    {heading}
  </p>
  <ul class="menu w-full">
    {
      docs.map((entry) => {
        const slug = docSlugOf(entry);
        const href = localePath(locale, `docs/${slug}`);
        const active = currentSlug === slug;
        return (
          <li>
            <a href={href} class:list={[{ "menu-active": active }]} aria-current={active ? "page" : undefined}>
              <UiIcon name={docIcon(slug)} />
              {entry.data.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
