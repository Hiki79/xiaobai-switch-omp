---
import { t } from "../i18n/ui";
import type { TocItem } from "../lib/toc";
import type { Locale } from "../lib/site";
import UiIcon from "./UiIcon.astro";

interface Props {
  locale: Locale;
  items: TocItem[];
}

const { locale, items } = Astro.props;
const heading = t(locale, "docs").onThisPage;
---

{
  items.length > 0 && (
    <nav aria-label={heading} class="text-sm">
      <p class="mb-2 flex items-center gap-2 font-semibold opacity-70">
        <UiIcon name="lucide:list-tree" />
        {heading}
      </p>
      <ul class="flex flex-col gap-1">
        {items.map((item) => (
          <li class:list={[{ "pl-3": item.depth === 3 }]}>
            <a class="link link-hover opacity-80" href={`#${item.id}`}>
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
