---
import { t } from "../i18n/ui";
import { APP_NAME, GITHUB_REPO_URL, localePath, type Locale } from "../lib/site";
import UiIcon from "./UiIcon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const footer = t(locale, "footer");
const nav = t(locale, "nav");
---

<footer class="bg-base-200 text-base-content mt-auto w-full">
  <div class="page-wrap">
    <div class="footer sm:footer-horizontal items-start py-10">
      <aside>
        <p class="text-lg font-bold">{APP_NAME}</p>
        <p class="max-w-xs opacity-80">{footer.tagline}</p>
      </aside>
      <nav>
        <h2 class="footer-title">{footer.product}</h2>
        <a class="link link-hover inline-flex items-center gap-2" href={localePath(locale, "docs")}>
          <UiIcon name="lucide:book-open" />
          {nav.docs}
        </a>
        <a class="link link-hover inline-flex items-center gap-2" href={localePath(locale, "download")}>
          <UiIcon name="lucide:download" />
          {nav.download}
        </a>
      </nav>
      <nav>
        <h2 class="footer-title">{footer.source}</h2>
        <a class="link link-hover inline-flex items-center gap-2" href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">
          <UiIcon name="lucide:github" />
          {nav.github}
        </a>
        <span>{footer.license}</span>
      </nav>
    </div>
  </div>
</footer>
