---
import { t } from "../i18n/ui";
import { APP_NAME, GITHUB_REPO_URL, assetUrl, localePath, type Locale } from "../lib/site";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import UiIcon from "./UiIcon.astro";

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug = "" } = Astro.props;
const nav = t(locale, "nav");
const home = localePath(locale, "");
const docs = localePath(locale, "docs");
const download = localePath(locale, "download");
const onDocs = slug === "docs" || slug.startsWith("docs/");
const onDownload = slug === "download";
---

<a href="#content" class="btn btn-sm absolute left-4 top-4 z-50 -translate-y-16 focus:translate-y-0">
  {nav.skip}
</a>
<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="page-wrap">
    <div class="navbar min-h-16 px-0">
      <div class="navbar-start gap-1">
        <label for="app-drawer" class="btn btn-ghost btn-square lg:hidden" aria-label={nav.menu}>
          <UiIcon name="lucide:menu" class="size-5" />
        </label>
        <a href={home} class="btn btn-ghost gap-2 px-2 text-base font-bold normal-case">
          <img src={assetUrl("images/logo.png")} alt="" width="32" height="32" class="h-8 w-8 rounded-xl" />
          {APP_NAME}
        </a>
      </div>
      <div class="navbar-end gap-1">
        <nav class="hidden lg:flex" aria-label="Primary">
          <ul class="menu menu-horizontal gap-1 px-1">
            <li>
              <a href={docs} class:list={[{ "menu-active": onDocs }]}>
                <UiIcon name="lucide:book-open" />
                {nav.docs}
              </a>
            </li>
            <li>
              <a href={download} class:list={[{ "menu-active": onDownload }]}>
                <UiIcon name="lucide:download" />
                {nav.download}
              </a>
            </li>
            <li>
              <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">
                <UiIcon name="lucide:github" />
                {nav.github}
              </a>
            </li>
          </ul>
        </nav>
        <LangSwitch locale={locale} slug={slug} />
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </div>
</header>
