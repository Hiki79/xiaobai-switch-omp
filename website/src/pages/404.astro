---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { localePath } from "../lib/site";
import UiIcon from "../components/UiIcon.astro";

const locale = "zh";
const seo = t(locale, "seo");
const copy = t(locale, "notFound");
---

<BaseLayout locale={locale} title={seo.notFoundTitle} description={seo.notFoundDescription}>
  <div class="flex flex-1 items-center justify-center">
    <div class="page-wrap text-center">
      <div class="max-w-md">
        <p class="text-6xl font-bold">404</p>
        <h1 class="mt-4 text-3xl font-bold">{copy.title}</h1>
        <p class="py-4 opacity-80">{copy.body}</p>
        <div class="flex justify-center gap-3">
          <a class="btn btn-primary" href={localePath("zh", "")}>
            <UiIcon name="lucide:house" />
            {copy.home}
          </a>
          <a class="btn btn-outline" href={localePath("zh", "docs")}>
            <UiIcon name="lucide:book-open" />
            {copy.docs}
          </a>
          <a class="btn btn-ghost" href={localePath("en", "")}>English</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
